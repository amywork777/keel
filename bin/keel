#!/usr/bin/env bash
# Run Python with keel and NVIDIA's usd-brep kernel.
#
#   bin/keel examples/bracket.py        run a script (files it writes land beside it)
#   bin/keel -m pytest tests            any python arguments work
#   bin/keel                            interactive python
#
# Runs natively when it can:
#   - a native kernel build (native/build.sh) with its .venv python, e.g. on macOS
#   - Linux/Windows with `pip install usd-brep`
# Otherwise it runs inside Docker with the current directory mounted.
# KEEL_DOCKER=1 forces Docker.
set -euo pipefail
KEEL_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${KEEL_DOCKER:-0}" != "1" ]]; then
  if compgen -G "$KEEL_HOME/native/build/_omni_solid*.so" >/dev/null && [[ -x "$KEEL_HOME/.venv/bin/python" ]]; then
    PYTHONPATH="$KEEL_HOME/src${PYTHONPATH:+:$PYTHONPATH}" exec "$KEEL_HOME/.venv/bin/python" "$@"
  fi
  if [[ "$(uname -s)" != "Darwin" ]] && python3 -c "import usd_brep" 2>/dev/null; then
    PYTHONPATH="$KEEL_HOME/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 "$@"
  fi
fi

IMAGE="${KEEL_IMAGE:-keel-dev}"
if ! docker info >/dev/null 2>&1; then
  echo "keel: Docker is not running (start Docker Desktop and retry)" >&2
  exit 1
fi
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "keel: building the kernel image (one time)..." >&2
  docker build -q -t "$IMAGE" "$KEEL_HOME/docker" >/dev/null
fi
TTY=()
[[ -t 0 && -t 1 ]] && TTY=(-it)
exec docker run --rm ${TTY[@]+"${TTY[@]}"} \
  -v "$KEEL_HOME":/keel:ro -v "$PWD":/work -w /work \
  -e PYTHONPATH=/keel/src -e PYTHONDONTWRITEBYTECODE=1 \
  --user "$(id -u):$(id -g)" -e HOME=/tmp \
  "$IMAGE" python "$@"
